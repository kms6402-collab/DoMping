<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ThumbControlBackground.Light" Color="#223028" />
  <SolidColorBrush x:Key="ThumbControlBackground.Dark" Color="#223028" />
  <SolidColorBrush x:Key="ThumbControlMouseOver.Light" Color="#1f6b46" />
  <SolidColorBrush x:Key="ThumbControlMouseOver.Dark" Color="#1f6b46" />
  <SolidColorBrush x:Key="ThumbControlClick.Light" Color="#33ff99" />
  <SolidColorBrush x:Key="ThumbControlClick.Dark" Color="#33ff99" />
  <SolidColorBrush x:Key="SliderTrackColor.Light" Color="#10160f" />
  <SolidColorBrush x:Key="SliderTrackColor.Dark" Color="#17201a" />
  <SolidColorBrush x:Key="UpDownControlBackground" Color="Transparent" />
  <SolidColorBrush x:Key="UpDownControlMouseOver" Color="Transparent" />
  <SolidColorBrush x:Key="GlyphColor" Color="#5f7d6c" />
  <SolidColorBrush x:Key="GlyphHoverColor" Color="#33ff99" />
  <SolidColorBrush x:Key="GlyphClickColor" Color="#1f6b46" />
  <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" Margin="0" BorderThickness="0" Background="{StaticResource UpDownControlBackground}">
            <Path Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource GlyphColor}" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource UpDownControlMouseOver}" />
              <Setter TargetName="Arrow" Property="Shape.Fill" Value="{StaticResource GlyphHoverColor}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Arrow" Property="Shape.Fill" Value="{StaticResource GlyphClickColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Border" BorderThickness="0" Background="{StaticResource ThumbControlBackground.Light}" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource ThumbControlMouseOver.Light}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseCaptured" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource ThumbControlClick.Light}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBarThumb.Dark" TargetType="{x:Type Thumb}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Border" BorderThickness="0" Background="{StaticResource ThumbControlBackground.Dark}" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource ThumbControlMouseOver.Dark}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseCaptured" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource ThumbControlClick.Dark}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition MaxHeight="13" />
        <RowDefinition Height="0.00001*" />
        <RowDefinition MaxHeight="13" />
      </Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Background="{StaticResource SliderTrackColor.Light}" />
      <RepeatButton Grid.Row="0" Height="13" Command="ScrollBar.LineUpCommand" Content="M 0 4 L 8 4 L 4 0 Z" Style="{StaticResource ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Margin="2,0" Style="{StaticResource ScrollBarThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="2" Height="13" Command="ScrollBar.LineDownCommand" Content="M 0 0 L 4 4 L 8 0 Z" Style="{StaticResource ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="VerticalScrollBar.Dark" TargetType="{x:Type ScrollBar}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition MaxHeight="13" />
        <RowDefinition Height="0.00001*" />
        <RowDefinition MaxHeight="13" />
      </Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Background="{StaticResource SliderTrackColor.Dark}" />
      <RepeatButton Grid.Row="0" Height="13" Command="ScrollBar.LineUpCommand" Content="M 0 4 L 8 4 L 4 0 Z" Style="{StaticResource ScrollBarLineButton}" />
      <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Margin="2,0" Style="{StaticResource ScrollBarThumb.Dark}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="2" Height="13" Command="ScrollBar.LineDownCommand" Content="M 0 0 L 4 4 L 8 0 Z" Style="{StaticResource ScrollBarLineButton}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollBarStyle.Probe" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollBarStyle.Dark" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar.Dark}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
