<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="LabelToolTip" TargetType="{x:Type Label}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Label}">
          <Border Background="#00FFFFFF" Margin="7,0,0,0" Padding="3" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000" SnapsToDevicePixels="True">
            <FrameworkElement.ToolTip>
              <ToolTip Background="#17201a" BorderBrush="#223028" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Image Grid.Column="0" Width="16" Height="16" Margin="7,13,7,7" VerticalAlignment="Top" Source="{StaticResource icon.domping-logo-simple}" />
                  <ContentPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Grid.Column="1" Margin="5,10,7,10" Width="{TemplateBinding FrameworkElement.MaxWidth}">
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                          <Setter Property="TextWrapping" Value="Wrap" />
                          <Setter Property="FontSize" Value="12" />
                          <Setter Property="Foreground" Value="#ffffff" />
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                  </ContentPresenter>
                </Grid>
              </ToolTip>
            </FrameworkElement.ToolTip>
            <Image Width="14" Height="14" Source="{StaticResource icon.question-circle}" />
          </Border>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#ffffff" />
              </Style>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>