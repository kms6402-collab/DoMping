              <Grid Name="markGrid">
                <Path Name="optionMark" Data="F1 M9.97498,1.22334 L4.6983,9.09834 L4.52164,9.09834 L0,5.19331 L1.27664,3.52165 L4.255,6.08833 L8.33331,1.52588E-05 L9.97498,1.22334" Margin="1" Opacity="0" Stretch="None" Fill="{StaticResource OptionMark.Dark.Static.Glyph}" />
