<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="DoMping.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:System="clr-namespace:System;assembly=mscorlib" ShutdownMode="OnMainWindowClose" xmlns:domping="clr-namespace:DoMping;assembly=DoMping" StartupUri="Views/MainWindow.xaml" Startup="Application_Startup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ResourceDictionaries/FocusVisualStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/Icons.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ValueConverters.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ButtonStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/DataGridStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ListBoxStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/OptionsHeaderStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/TabControlStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/TextBoxStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ToolTipStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ComboBoxStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/RadioButtonStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/ScrollBarStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/WindowChrome.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/MenuItemStyle.xaml" />
        <ResourceDictionary Source="ResourceDictionaries/SliderStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
      <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#ffffff" />
        <Setter Property="Background" Value="#0a0f0c" />
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type AccessText}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#ffffff" />
      </Style>
      <Style TargetType="{x:Type Menu}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type MenuItem}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>