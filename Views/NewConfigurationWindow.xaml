<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.NewConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:DoMping.Views" Title="Save" Height="Auto" Width="520" SizeToContent="Height" ResizeMode="NoResize" Background="#0a0f0c" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="20,20,20,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Source="{StaticResource icon.file-code}" Margin="0,3,0,0" VerticalAlignment="Top" Opacity="0.8" Width="32" Height="32" />
      <DockPanel Grid.Column="1" Margin="20,0,0,0">
        <TextBlock DockPanel.Dock="Top" FontSize="14" Foreground="#ffffff" TextWrapping="Wrap">A new configuration file is needed to save your settings.<LineBreak />The file will be stored in the following location:</TextBlock>
        <TextBlock Name="FilePath" DockPanel.Dock="Top" Margin="0,7,0,0" FontSize="12" Foreground="#33ff99" TextWrapping="Wrap" Text="C:\Users\username\AppData\Local\DoMping\DoMping.xml" />
        <TextBlock DockPanel.Dock="Top" Margin="0,20,0,5" FontSize="12" Foreground="#5f7d6c" TextWrapping="Wrap">Choose portable mode to save your configuration alongside DoMping.exe.</TextBlock>
      </DockPanel>
    </Grid>
    <Border Grid.Row="1" Background="#17201a" BorderBrush="#223028" BorderThickness="0,1,0,0">
      <DockPanel Margin="10">
        <CheckBox Name="PortableMode" DockPanel.Dock="Left" Padding="5,0,10,0" Foreground="#ffffff" Content="Portable mode" Click="PortableMode_Click" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource ButtonStandardStyle}" Width="100" IsDefault="True" Content="Save" Click="Save_Click" />
          <Button Style="{StaticResource ButtonStandardStyle}" Margin="8,0,0,0" Width="100" IsCancel="True" Content="Cancel" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>