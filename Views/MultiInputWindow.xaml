<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.MultiInputWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Input Addresses" UseLayoutRounding="True" Height="450" MinHeight="250" Width="350" MinWidth="280" Background="#0a0f0c" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:views="clr-namespace:DoMping.Views;assembly=DoMping" SourceInitialized="Window_SourceInitialized">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#10160f" />
        <Setter Property="BorderBrush" Value="#223028" />
        <Setter Property="Foreground" Value="#ffffff" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UIElement.AllowDrop" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#1f6b46" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#33ff99" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
              <Condition Property="TextBoxBase.IsSelectionActive" Value="False" />
            </MultiTrigger.Conditions>
            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <Image DockPanel.Dock="Left" Source="{StaticResource icon.input-addresses}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
      <TextBlock DockPanel.Dock="Left" Text="Enter addresses to ping" Style="{StaticResource OptionHeaderTextStyle}" />
      <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" MaxWidth="280">
        <TextBlock>Type a list of addresses to ping, one per line or comma separated:<LineBreak /><LineBreak /><Bold>10.0.1.5</Bold> — a single host<LineBreak /><Bold>10.0.1.5/WebServer</Bold> — host with an alias (saved to Aliases too)<LineBreak /><Bold>10.0.1.0/24</Bold> — every host in the subnet<LineBreak /><Bold>10.0.1.10-10.0.1.50</Bold> or <Bold>10.0.1.10-50</Bold> — an IP range<LineBreak /><LineBreak />Drag and drop a text or CSV file here, or use Import below.<LineBreak />CSV format: host,alias (one row per host).<LineBreak /><LineBreak />Expansions are capped at 4,096 addresses per entry.</TextBlock>
      </Label>
    </DockPanel>
    <TextBox Name="MyAddresses" Grid.Row="1" Style="{StaticResource TextBoxStyle}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Padding="5" AllowDrop="True" PreviewDragOver="MyAddresses_PreviewDragOver" Drop="MyAddresses_Drop" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
      <Button Style="{StaticResource ButtonStandardStyle}" Content="Import..." Width="85" Click="ImportCsv_Click" />
      <Button Style="{StaticResource ButtonStandardStyle}" Content="OK" Width="85" Margin="9,0,0,0" Click="OK_Click" />
      <Button Style="{StaticResource ButtonStandardStyle}" Content="Cancel" Width="85" Margin="9,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>