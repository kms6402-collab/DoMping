<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.NewAliasWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="New Alias" UseLayoutRounding="True" Height="Auto" Width="400" SizeToContent="Height" ResizeMode="NoResize" Background="#0a0f0c" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:views="clr-namespace:DoMping.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="9">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
        <Image Source="{StaticResource icon.alias}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
        <TextBlock Text="{x:Static resource:Strings.NewAlias_Header}" TextTrimming="CharacterEllipsis" Style="{StaticResource OptionHeaderTextStyle}" />
      </StackPanel>
      <DockPanel Dock="Top" Margin="0,0,0,8">
        <Border Width="50" Margin="0,0,15,0">
          <TextBlock Text="{x:Static resource:Strings.NewAlias_Host}" FontSize="14" VerticalAlignment="Center" Foreground="#5f7d6c" HorizontalAlignment="Right" />
        </Border>
        <TextBox Name="MyHost" MaxLength="64" />
      </DockPanel>
      <DockPanel Dock="Top" Margin="0,0,0,10">
        <Border Width="50" Margin="0,0,15,0">
          <TextBlock Text="{x:Static resource:Strings.NewAlias_Alias}" FontSize="14" VerticalAlignment="Center" Foreground="#5f7d6c" HorizontalAlignment="Right" />
        </Border>
        <TextBox Name="MyAlias" MaxLength="64" />
      </DockPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="9,0,9,9">
      <Button Style="{StaticResource ButtonStandardStyle}" IsDefault="True" Margin="0,0,9,0" Width="85" Content="{x:Static resource:Strings.DialogButton_Save}" Click="Save_Click" />
      <Button Style="{StaticResource ButtonStandardStyle}" Width="85" IsCancel="True" Content="{x:Static resource:Strings.DialogButton_Cancel}" />
    </StackPanel>
  </Grid>
</Window>