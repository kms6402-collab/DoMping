<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.StatusHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="{x:Static resource:Strings.StatusHistory_WindowTitle}" UseLayoutRounding="True" Height="400" Width="720" MinHeight="250" MinWidth="620" Background="#0a0f0c" WindowStyle="None" xmlns:views="clr-namespace:DoMping.Views" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBarStyle.Dark}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Style="{StaticResource WindowMainPanelStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="16" Height="16" Margin="6,0,4,0" Source="{StaticResource icon.status-history-dark}" />
        <TextBlock Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#ffffff" Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        <Button Grid.Column="4" RenderOptions.EdgeMode="Aliased" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimize" ToolTipService.InitialShowDelay="1000" Foreground="#ffffff" Click="OnMinimizeButtonClick">
          <Path Width="46" Height="26" Data="M18,15 L28,15" StrokeThickness="1" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Name="maximizeButton" Grid.Column="5" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximize" ToolTipService.InitialShowDelay="1000" Foreground="#ffffff" Click="OnMaximizeRestoreButtonClick">
          <Path Width="46" Height="28" Data="M18.5,10.5 L27.5,10.5 L27.5,19.5 L18.5,19.5" StrokeThickness="1" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Name="restoreButton" Grid.Column="5" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Restore Down" ToolTipService.InitialShowDelay="1000" Foreground="#ffffff" Click="OnMaximizeRestoreButtonClick">
          <Path Width="46" Height="28" Data="M18.5,12.5 L25.5,12.5 L25.5,19.5 L18.5,19.5 M20.5,12.5 L20.5,10.5 L27.5,10.5 L27.5,17.5 L25.5,17.5" StrokeThickness="1" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Grid.Column="6" Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="Close" ToolTipService.InitialShowDelay="1000" Foreground="#ffffff" Click="OnCloseButtonClick">
          <Path Width="46" Height="28" Data="M18,11 L27,20 M18,20 L27,11" StrokeThickness="1" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
      </Grid>
      <DataGrid Name="StatusHistory" Grid.Row="1" FontSize="16" FontFamily="Consolas" Background="#10160f" Foreground="#ffffff" Style="{StaticResource StatusHistoryDataGridStyle}">
        <DataGrid.CellStyle>
          <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="UIElement.IsHitTestVisible" Value="False" />
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Timestamp" MinWidth="90" Binding="{Binding Timestamp}">
            <DataGridColumn.CellStyle>
              <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="{x:Type DataGridCell}">
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusAsGlyph}">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="TextBlock.Padding" Value="3,2,0,2" />
                              <Setter Property="FontFamily" Value="Marlett" />
                              <Setter Property="VerticalAlignment" Value="Center" />
                              <Setter Property="UIElement.IsHitTestVisible" Value="False" />
                              <Setter Property="FontSize" Value="12" />
                              <Style.Triggers>
                                <DataTrigger Value="{x:Static resource:Strings.StatusChange_Down}" Binding="{Binding StatusAsString}">
                                  <Setter Property="Foreground" Value="#ff5d5d" />
                                </DataTrigger>
                                <DataTrigger Value="{x:Static resource:Strings.StatusChange_Error}" Binding="{Binding StatusAsString}">
                                  <Setter Property="Foreground" Value="#ff5d5d" />
                                </DataTrigger>
                                <DataTrigger Value="{x:Static resource:Strings.StatusChange_Up}" Binding="{Binding StatusAsString}">
                                  <Setter Property="Foreground" Value="#33ff99" />
                                </DataTrigger>
                                <DataTrigger Value="{x:Static resource:Strings.StatusChange_Start}" Binding="{Binding StatusAsString}">
                                  <Setter Property="Foreground" Value="#1f6b46" />
                                </DataTrigger>
                                <DataTrigger Value="{x:Static resource:Strings.StatusChange_Stop}" Binding="{Binding StatusAsString}">
                                  <Setter Property="Foreground" Value="#ffcf5c" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                        <TextBlock Foreground="#5f7d6c" Padding="4,2,0,0" Text="{Binding Timestamp, StringFormat=d}" />
                        <TextBlock Text=" " />
                        <TextBlock Foreground="#ffffff" Padding="0,2,25,2" Text="{Binding Timestamp, StringFormat=T}" />
                      </StackPanel>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </DataGridColumn.CellStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Address" MinWidth="90" Binding="{Binding Hostname}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextBlock.Padding" Value="5,2,25,2" />
                <Setter Property="Foreground" Value="#ffffff" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Alias" MinWidth="50" Binding="{Binding Alias}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextBlock.Padding" Value="5,2,25,2" />
                <Setter Property="Foreground" Value="#ffffff" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Status" Width="*" Binding="{Binding StatusAsString}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextBlock.Padding" Value="5,2" />
                <Style.Triggers>
                  <DataTrigger Value="{x:Static resource:Strings.StatusChange_Down}" Binding="{Binding StatusAsString}">
                    <Setter Property="Foreground" Value="#ff5d5d" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static resource:Strings.StatusChange_Error}" Binding="{Binding StatusAsString}">
                    <Setter Property="Foreground" Value="#ff5d5d" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static resource:Strings.StatusChange_Up}" Binding="{Binding StatusAsString}">
                    <Setter Property="Foreground" Value="#33ff99" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static resource:Strings.StatusChange_Start}" Binding="{Binding StatusAsString}">
                    <Setter Property="Foreground" Value="#1f6b46" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static resource:Strings.StatusChange_Stop}" Binding="{Binding StatusAsString}">
                    <Setter Property="Foreground" Value="#ffcf5c" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Row="2">
        <DockPanel Dock="Left" Margin="12,6,6,12">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Filter" Foreground="#33ff99" Margin="0,0,0,2" />
            <Grid>
              <TextBox Name="FilterField" Style="{StaticResource TextBoxStyle.Dark}" Width="300" KeyUp="TextBox_KeyUp" />
              <Button HorizontalAlignment="Right" Width="20" Margin="1" Focusable="False" IsTabStop="False" Click="FilterClear_Click">
                <Control.Template>
                  <ControlTemplate>
                    <Border>
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="#00000000" />
                          <Style.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter Property="Background" Value="#17201a" />
                            </Trigger>
                            <DataTrigger Value="" Binding="{Binding Path=Text, ElementName=FilterField}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <Image Source="{StaticResource icon.delete}" Width="13" Height="13" />
                    </Border>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Margin="15,0,0,0">
            <TextBlock Text="Include" Foreground="#33ff99" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal">
              <Grid Width="100">
                <CheckBox Name="FilterUp" Style="{StaticResource CheckBoxStyle.Dark}" Content="Up" IsChecked="True" Click="Filter_Click" />
              </Grid>
              <CheckBox Name="FilterStart" Style="{StaticResource CheckBoxStyle.Dark}" Content="Start" IsChecked="True" Click="Filter_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Grid Width="100">
                <CheckBox Name="FilterDown" Style="{StaticResource CheckBoxStyle.Dark}" Content="Down" IsChecked="True" Click="Filter_Click" />
              </Grid>
              <CheckBox Name="FilterStop" Style="{StaticResource CheckBoxStyle.Dark}" Content="Stop" IsChecked="True" Click="Filter_Click" />
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Left" Margin="25,0,0,0" HorizontalAlignment="Left">
            <TextBlock />
            <Button Style="{StaticResource ButtonStyle.Dark}" Content="Export" Width="100" Click="Export_Click" />
          </StackPanel>
        </DockPanel>
      </DockPanel>
      <Border Background="#0a0f0c" Grid.Row="1">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="0" Binding="{Binding Items.Count, ElementName=StatusHistory}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Foreground="#ffcf5c" FontSize="32" HorizontalAlignment="Center" Text="{x:Static resource:Strings.StatusHistory_NoChanges}" />
          <TextBlock Foreground="#ffffff" TextWrapping="Wrap" Margin="0,10,0,0" Text="{x:Static resource:Strings.StatusHistory_NoChangesDescription}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>