<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.TracerouteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DoMping.Views" xmlns:classes="clr-namespace:DoMping.Classes" UseLayoutRounding="True" Title="Traceroute" Height="460" MinHeight="300" Width="520" MinWidth="350" Background="#0a0f0c">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <classes:BoolToStringConverter x:Key="BoolToStringConverter" FalseValue="Trace" TrueValue="Stop" />
      <classes:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <classes:BooleanToImageConverter x:Key="BooleanToImageConverter" />
      <ControlTemplate x:Key="TextBoxControlTemplate" TargetType="{x:Type TextBox}">
        <Grid>
          <Border Name="border" CornerRadius="0" SnapsToDevicePixels="True" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}">
            <ScrollViewer Name="PART_ContentHost" />
          </Border>
          <TextBlock Name="placeholderText" Text="Enter target address" Visibility="Hidden" FontSize="12" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Courier New" Opacity="0.3" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="Control.Foreground" Value="#5f7d6c" />
            <Setter Property="Control.Background" Value="#17201a" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="TextBox.Text" Value="" />
              <Condition Property="UIElement.IsKeyboardFocused" Value="True" />
            </MultiTrigger.Conditions>
            <MultiTrigger.Setters>
              <Setter TargetName="placeholderText" Property="UIElement.Visibility" Value="Visible" />
            </MultiTrigger.Setters>
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel LastChildFill="True" Margin="15">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource OptionHeaderTextStyle}" Margin="0,5,0,10" Text="Trace Route to Destination" />
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Name="Hostname" FontSize="20" Padding="3,2" FontWeight="Regular" FontFamily="Consolas" BorderThickness="1,1,1,1" BorderBrush="#223028" VerticalContentAlignment="Center" Template="{StaticResource TextBoxControlTemplate}" IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}" />
      <Button Name="Trace" Grid.Column="1" IsDefault="True" FontSize="14" Padding="0,6" Margin="10,0,0,0" Width="100" Content="Trace" Foreground="#ffffff" Style="{StaticResource ButtonStandardStyle}" Background="#10160f" IsCancel="{Binding IsActive}" Click="Trace_Click">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="traceRouteButton_border" BorderThickness="1" BorderBrush="#223028" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Margin="0,0,8,0" Width="16" Height="16" Source="{Binding IsActive, Converter={StaticResource BooleanToImageConverter}}" />
                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="traceRouteButton_border" Property="Border.Background" Value="#17201a" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="traceRouteButton_border" Property="Border.Background" Value="#1f6b46" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
    </Grid>
    <Border DockPanel.Dock="Bottom" Background="#10160f" BorderBrush="#223028" BorderThickness="1,1,1,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <TextBlock Name="TraceStatus" Text="" Visibility="Collapsed" Margin="9,3" Foreground="#ffcf5c" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsActive}">
                <TriggerBase.EnterActions>
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)" From="1" To=".2" BeginTime="0:0:0.0" Duration="0:0:0.4" />
                    </Storyboard>
                  </BeginStoryboard>
                </TriggerBase.EnterActions>
                <TriggerBase.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)" From="1" To="1" Duration="0:0:0.0" FillBehavior="HoldEnd" />
                    </Storyboard>
                  </BeginStoryboard>
                </TriggerBase.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
    </Border>
    <DataGrid Name="TraceData" DockPanel.Dock="Top" Margin="0,20,0,0" Padding="0" CanUserSortColumns="False" HorizontalGridLinesBrush="#223028" VerticalGridLinesBrush="#223028" GridLinesVisibility="Horizontal" ColumnWidth="SizeToCells" BorderBrush="#223028" BorderThickness="1,1,1,0" FontSize="17" FontFamily="Consolas" Background="#10160f" Foreground="#ffffff" RowBackground="#10160f" AlternatingRowBackground="#17201a" Style="{StaticResource DataGridStyle}">
      <DataGrid.CellStyle>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="UIElement.IsHitTestVisible" Value="False" />
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="{x:Type DataGridColumnHeader}">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="5,0,0,0" />
          <Setter Property="BorderThickness" Value="2,2,1,2" />
          <Setter Property="BorderBrush" Value="#223028" />
          <Setter Property="Background" Value="#17201a" />
          <Setter Property="Foreground" Value="#ffffff" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Hop" Width="50" MinWidth="40" Binding="{Binding HopId}">
          <DataGridColumn.CellStyle>
            <Style TargetType="{x:Type DataGridCell}">
              <Setter Property="FontWeight" Value="Regular" />
              <Setter Property="HorizontalAlignment" Value="Right" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Foreground" Value="#5f7d6c" />
              <Setter Property="UIElement.IsHitTestVisible" Value="False" />
            </Style>
          </DataGridColumn.CellStyle>
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextBlock.Padding" Value="15,1,25,1" />
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="IP Address" Width="Auto" MinWidth="100" Binding="{Binding HostAddress}">
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextBlock.Padding" Value="5,1,35,1" />
              <Setter Property="Foreground" Value="#ffffff" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Text" Value="{Binding HostAddress}" />
              <Style.Triggers>
                <DataTrigger Value="Timed out" Binding="{Binding HostAddress}">
                  <Setter Property="Foreground" Value="#ff5d5d" />
                </DataTrigger>
                <DataTrigger Value="Invalid hostname" Binding="{Binding HostAddress}">
                  <Setter Property="Foreground" Value="#ff5d5d" />
                </DataTrigger>
                <DataTrigger Value="0.0.0.0" Binding="{Binding HostAddress}">
                  <Setter Property="Foreground" Value="#ff5d5d" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="RTT" Width="*" Binding="{Binding RoundTripTime, StringFormat=[{0} ms]}">
          <DataGridColumn.CellStyle>
            <Style TargetType="{x:Type DataGridCell}">
              <Setter Property="Foreground" Value="#ffffff" />
              <Setter Property="UIElement.IsHitTestVisible" Value="False" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </DataGridColumn.CellStyle>
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextBlock.Padding" Value="5,1" />
              <Style.Triggers>
                <DataTrigger Value="Timed out" Binding="{Binding HostAddress}">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Value="Invalid hostname" Binding="{Binding HostAddress}">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HostAddress}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>