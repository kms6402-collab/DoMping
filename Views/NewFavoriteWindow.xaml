<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.NewFavoriteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="New Favorite" UseLayoutRounding="True" Height="450" Width="450" MinHeight="350" MinWidth="300" ResizeMode="CanResize" Background="#0a0f0c" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:views="clr-namespace:DoMping.Views" SourceInitialized="Window_SourceInitialized">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="9">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
        <Image Name="HeaderIcon" Source="{StaticResource icon.new-favorite}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
        <TextBlock Name="Header" DockPanel.Dock="Top" Text="{x:Static resource:Strings.NewFavorite_Header}" Style="{StaticResource OptionHeaderTextStyle}" />
      </StackPanel>
      <Grid DockPanel.Dock="Top" Margin="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{x:Static resource:Strings.NewFavorite_Title}" Foreground="#5f7d6c" FontSize="14" VerticalAlignment="Center" />
          <TextBox Name="MyTitle" Margin="0,4,0,0" MaxLength="64" />
        </StackPanel>
        <StackPanel Grid.Column="1" Width="80" Margin="20,0,0,0">
          <TextBlock Text="Columns" Foreground="#5f7d6c" FontSize="14" VerticalAlignment="Center" />
          <TextBox Name="MyColumnCount" DockPanel.Dock="Top" Margin="0,4,0,0" MaxLength="2" PreviewTextInput="MyColumnCount_PreviewTextInput" />
        </StackPanel>
      </Grid>
      <DockPanel Name="ContentsSection" Dock="Top" Margin="0,10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,15,0,0">
          <TextBlock Text="Hosts to include in favorite set" Foreground="#5f7d6c" FontSize="14" VerticalAlignment="Center" />
          <Label Style="{StaticResource LabelToolTip}" MaxWidth="380">
            <TextBlock>Type a list of addresses to include in this favorite set.<LineBreak />Enter either one per line or comma separated.<LineBreak /><LineBreak />If you have a text file containing hosts, drag and drop it here.</TextBlock>
          </Label>
        </StackPanel>
        <TextBox Name="MyHosts" FontFamily="Consolas" FontSize="15" Height="Auto" Margin="0,3,0,0" Padding="4" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AllowDrop="True" PreviewDragOver="MyHosts_PreviewDragOver" Drop="MyHosts_Drop" />
      </DockPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="9,0,9,9">
      <Button Style="{StaticResource ButtonStandardStyle}" IsDefault="True" Margin="0,0,9,0" Width="85" Content="{x:Static resource:Strings.DialogButton_Save}" Click="Save_Click" />
      <Button Style="{StaticResource ButtonStandardStyle}" Width="85" IsCancel="True" Content="{x:Static resource:Strings.DialogButton_Cancel}" />
    </StackPanel>
  </Grid>
</Window>