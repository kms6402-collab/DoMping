<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.DialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="DoMping" UseLayoutRounding="True" Height="200" Width="480" ResizeMode="NoResize" Background="#0a0f0c" WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False" xmlns:views="clr-namespace:DoMping.Views">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="20,10,20,35">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Name="MyIcon" Source="{StaticResource icon.exclamation-triangle}" VerticalAlignment="Top" Width="32" Height="32" />
      <DockPanel Grid.Column="1" Margin="15,7,0,0">
        <TextBlock Name="MyTitle" DockPanel.Dock="Top" Text="Warning" Foreground="#ffffff" VerticalAlignment="Center" FontSize="15" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
        <TextBlock Name="Body" DockPanel.Dock="Top" FontSize="13" Margin="0,15,0,0" Foreground="#ffffff" Text="This is warning text" TextWrapping="Wrap" />
      </DockPanel>
    </Grid>
    <Border Grid.Row="1" Background="#17201a" BorderBrush="#223028" BorderThickness="0,1,0,0">
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
        <Button Name="OK" Style="{StaticResource ButtonStandardStyle}" Width="100" Content="{x:Static resource:Strings.DialogButton_OK}" IsCancel="{Binding Visibility, ElementName=Cancel, Converter={StaticResource InverseHiddenToBoolConverter}}" Click="OK_Click" />
        <Button Name="Cancel" Style="{StaticResource ButtonStandardStyle}" Margin="8,0,0,0" Width="100" IsCancel="True" Content="{x:Static resource:Strings.DialogButton_Cancel}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>