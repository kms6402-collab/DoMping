<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.ManageFavoritesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="{x:Static resource:Strings.ManageFavorites_WindowTitle}" UseLayoutRounding="True" Height="475" MinHeight="300" Width="600" MinWidth="425" WindowStartupLocation="CenterScreen" Background="#0a0f0c" ResizeMode="CanResize" xmlns:views="clr-namespace:DoMping.Views" PreviewKeyDown="Window_PreviewKeyDown" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="{StaticResource icon.favorite}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
      <TextBlock Style="{StaticResource OptionHeaderTextStyle}" Text="{x:Static resource:Strings.ManageFavorites_Header}" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="50" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width=".85*" MinWidth="50" />
      </Grid.ColumnDefinitions>
      <ListBox Name="Favorites" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Style="{StaticResource FavoritesListBox}" ItemContainerStyle="{StaticResource FavoritesListBoxItemsStyle}" SelectionChanged="Favorites_SelectionChanged" />
      <GridSplitter Grid.Column="1" Background="#00FFFFFF" HorizontalAlignment="Stretch" Focusable="False" Visibility="{Binding ElementName=ContentsSection, Path=Visibility}" />
      <Border Name="ContentsSection" Grid.Column="2" Background="#10160f" BorderBrush="#223028" Visibility="Visible" VerticalAlignment="Stretch" BorderThickness="1">
        <DockPanel Background="#10160f">
          <TextBlock Name="FavoriteTitle" DockPanel.Dock="Top" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14" Padding="5,5,5,7" Foreground="#ffffff" Background="#00FFFFFF" FontWeight="SemiBold" />
          <ListBox Name="Contents" Foreground="#ffffff" Background="#00FFFFFF" BorderThickness="0" Margin="0" SelectionMode="Single" FontFamily="Consolas" FontSize="15" ItemContainerStyle="{StaticResource ListBoxItemNoHighlightStyle}" />
        </DockPanel>
        <UIElement.Effect>
          <DropShadowEffect Opacity="0.1" />
        </UIElement.Effect>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
      <Button Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_New" Click="New_Click" />
      <Button Margin="15,0" Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_Edit" IsEnabled="{Binding ElementName=Favorites, Path=SelectedItems.Count}" Click="Edit_Click" />
      <Button Name="Remove" Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_Remove" IsEnabled="{Binding ElementName=Favorites, Path=SelectedItems.Count}" Click="Remove_Click" />
    </StackPanel>
  </Grid>
</Window>