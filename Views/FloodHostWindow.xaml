<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.FloodHostWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DoMping.Views" xmlns:classes="clr-namespace:DoMping.Classes" Title="DoMping - Flood Host" Height="250" Width="400" ResizeMode="CanMinimize" Background="#0a0f0c">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <classes:BoolToStringConverter x:Key="BoolToStringConverter" FalseValue="Flood Host" TrueValue="Stop Flood" />
      <classes:BooleanToHiddenVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" />
      <classes:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <classes:BooleanToImageConverter x:Key="BooleanToImageConverter" />
      <ControlTemplate x:Key="TextBoxBaseControlTemplatez" TargetType="{x:Type TextBoxBase}">
        <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}">
          <ScrollViewer Name="PART_ContentHost" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="Control.Background" Value="#17201a" />
            <Setter Property="Control.Foreground" Value="#5f7d6c" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style TargetType="{x:Type Window}">
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding IsActive}">
          <TriggerBase.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation From="#0a0f0c" To="#17201a" Storyboard.TargetProperty="(Window.Background).(SolidColorBrush.Color)" RepeatBehavior="Forever" AutoReverse="True" Duration="0:0:.6" />
              </Storyboard>
            </BeginStoryboard>
          </TriggerBase.EnterActions>
          <TriggerBase.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation From="#0a0f0c" To="#0a0f0c" Storyboard.TargetProperty="(Window.Background).(SolidColorBrush.Color)" Duration="0:0:0.0" FillBehavior="HoldEnd" />
              </Storyboard>
            </BeginStoryboard>
          </TriggerBase.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Name="txtHostname" FontSize="18" FontWeight="Bold" BorderThickness="2,2,0,2" BorderBrush="#223028" VerticalContentAlignment="Center" Template="{StaticResource TextBoxBaseControlTemplatez}" IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}" />
      <Button Name="btnFloodHost" Grid.Column="1" IsDefault="True" FontSize="14" Padding="0,6" Width="125" Background="#1f6b46" Click="btnFloodHost_Click">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="floodHostButton_border" BorderThickness="2" BorderBrush="#33ff99" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Margin="0,0,8,0" Width="16" Height="16" Source="{Binding IsActive, Converter={StaticResource BooleanToImageConverter}}" />
                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="floodHostButton_border" Property="Border.Background" Value="#278f5c" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="floodHostButton_border" Property="Border.Background" Value="#154a30" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
    </Grid>
    <Grid Row="1" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Packets Sent:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#5f7d6c" FontSize="16" FontWeight="Bold" />
        <TextBlock Name="tbPacketsSent" Grid.Column="1" Foreground="#33ff99" FontSize="22" Text="{Binding Path=PacketsSent, StringFormat='#,0'}" />
      </Grid>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Packets Received:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#5f7d6c" FontSize="16" FontWeight="Bold" />
        <TextBlock Name="tbPacketsReceived" Grid.Column="1" Foreground="#ffffff" FontSize="22" Text="{Binding Path=PacketsReceived, StringFormat='#,0'}" />
      </Grid>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Packets Lost:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#5f7d6c" FontSize="16" FontWeight="Bold" />
        <TextBlock Name="tbPacketsLost" Grid.Column="1" Foreground="#ff5d5d" FontSize="22" Text="{Binding Path=PacketsLost, StringFormat='#,0'}" />
      </Grid>
    </Grid>
    <TextBlock Name="tbStatus" Grid.Row="2" Text="Flood in progress..." Margin="0,7" HorizontalAlignment="Center" Foreground="#5f7d6c" FontSize="13" Visibility="{Binding IsActive, Converter={StaticResource BooleanToHiddenVisibilityConverter}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsActive}">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)" From="1" To=".2" BeginTime="0:0:1.25" Duration="0:0:0.3" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)" From="1" To="1" Duration="0:0:0.0" FillBehavior="HoldEnd" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Label Name="lblInformation" Grid.Row="1" Grid.RowSpan="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#5f7d6c" Background="#0a0f0c" Padding="40,0" FontSize="14">
      <TextBlock TextWrapping="Wrap" TextAlignment="Justify">This tool will send a continuous stream of ICMP ping packets to the destination host. It typically will not generate any more than 32 kilobytes per second of network traffic.</TextBlock>
    </Label>
  </Grid>
</Window>