<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.PopupNotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" UseLayoutRounding="True" Height="95" MinWidth="500" SizeToContent="Width" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" Background="#17201a" BorderBrush="#223028" BorderThickness="1" Topmost="True" ShowActivated="False" RenderTransformOrigin="1,1" AllowsTransparency="True" xmlns:views="clr-namespace:DoMping.Views" MouseLeftButtonUp="Window_MouseLeftButtonUp" SizeChanged="Window_SizeChanged">
  <UIElement.RenderTransform>
    <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
  </UIElement.RenderTransform>
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Duration="00:00:00.3" Storyboard.TargetProperty="Opacity" From="0" To="0.99" />
          <DoubleAnimation Duration="00:00:00.2" Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" From="0" To="1" />
          <DoubleAnimation Duration="00:00:00.2" Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" From="0" To="1" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </FrameworkElement.Triggers>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid HorizontalAlignment="Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Padding="6" Margin="0,1,3,0" Background="#00FFFFFF" HorizontalAlignment="Right" IsTabStop="False" ToolTip="Open status history window" ToolTipService.InitialShowDelay="1500" ToolTipService.ShowDuration="2000" Click="Maximize_Click">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="controlButton_border" BorderThickness="1" BorderBrush="#00FFFFFF" CornerRadius="4" Opacity="0.5" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}">
              <Image Name="controlButton_image" Source="{StaticResource icon.window-restore-white}" Width="12" Height="12" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="controlButton_border" Property="Border.Background" Value="#223028" />
                <Setter TargetName="controlButton_border" Property="UIElement.Opacity" Value="1" />
                <Setter TargetName="controlButton_image" Value="{StaticResource icon.window-restore-white}" Property="Image.Source" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="controlButton_border" Property="Border.BorderBrush" Value="#33ff99" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
      <Button Grid.Column="1" Padding="6" Margin="0,1,3,0" Background="#00FFFFFF" HorizontalAlignment="Right" IsTabStop="False" ToolTip="Close" ToolTipService.InitialShowDelay="1500" ToolTipService.ShowDuration="2000" Click="Close_Click">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="controlButton_border" BorderThickness="1" BorderBrush="#00FFFFFF" CornerRadius="4" Opacity="0.5" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}">
              <Image Name="controlButton_image" Source="{StaticResource icon.window-close-white}" Width="12" Height="12" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="controlButton_border" Property="Border.Background" Value="#ff5d5d" />
                <Setter TargetName="controlButton_border" Property="UIElement.Opacity" Value="1" />
                <Setter TargetName="controlButton_image" Value="{StaticResource icon.window-close-white}" Property="Image.Source" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="controlButton_border" Property="Border.BorderBrush" Value="#33ff99" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
    </Grid>
    <ListBox Name="StatusHistoryList" Grid.Row="1" Background="#00FFFFFF" SelectionMode="Single" BorderThickness="0" IsTabStop="False" MaxWidth="1200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" FocusVisualStyle="{x:Null}" MouseLeftButtonUp="Window_MouseLeftButtonUp">
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBarStyle.Dark}">
            <Setter Property="UIElement.Opacity" Value="0.7" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter Property="UIElement.Opacity" Value="1.0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
            <TextBlock Name="StatusIndicator" DockPanel.Dock="Left" FontSize="18" FontFamily="Marlett" VerticalAlignment="Center" Padding="5,0,0,0" Text="{Binding StatusAsGlyph}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Style.Triggers>
                    <DataTrigger Value="{x:Static resource:Strings.StatusChange_Down}" Binding="{Binding StatusAsString}">
                      <Setter Property="Foreground" Value="#ff5d5d" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static resource:Strings.StatusChange_Error}" Binding="{Binding StatusAsString}">
                      <Setter Property="Foreground" Value="#ff5d5d" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static resource:Strings.StatusChange_Up}" Binding="{Binding StatusAsString}">
                      <Setter Property="Foreground" Value="#33ff99" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static resource:Strings.StatusChange_LatencyHigh}" Binding="{Binding StatusAsString}">
                      <Setter Property="Foreground" Value="#ffcf5c" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static resource:Strings.StatusChange_LatencyNormal}" Binding="{Binding StatusAsString}">
                      <Setter Property="Foreground" Value="#1f6b46" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Left" FontSize="15" Foreground="#ffffff" VerticalAlignment="Center" Opacity="0.6" Padding="6,0,0,0" Text="{Binding Timestamp, StringFormat=[{0}]}" />
            <TextBlock DockPanel.Dock="Left" FontSize="17" Foreground="#ffffff" VerticalAlignment="Center" Padding="9,0,0,0" Text="{Binding AliasIfExistOrHostname}" />
            <TextBlock DockPanel.Dock="Left" Text="🠖" FontSize="17" Foreground="#ffffff" VerticalAlignment="Center" Opacity="0.6" Padding="5,0" />
            <TextBlock DockPanel.Dock="Left" FontSize="17" VerticalAlignment="Center" Text="{Binding StatusAsString}" Foreground="{Binding ElementName=StatusIndicator, Path=Foreground}" />
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
      <Image Source="{StaticResource icon.domping-logo-simple}" Width="16" Height="16" />
      <TextBlock Grid.Row="3" Text="DoMping" FontSize="13" Foreground="#ffffff" Opacity="0.5" Margin="7,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>