<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.EditAliasWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="Edit Alias" UseLayoutRounding="True" Height="Auto" Width="400" ResizeMode="NoResize" Background="#0a0f0c" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:views="clr-namespace:DoMping.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="9">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
        <Image Source="{StaticResource icon.edit}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
        <TextBlock Name="Header" Text="{x:Static resource:Strings.EditAlias_AliasFor}" TextTrimming="CharacterEllipsis" Style="{StaticResource OptionHeaderTextStyle}" />
      </StackPanel>
      <TextBox Name="MyAlias" DockPanel.Dock="Top" Margin="0,0,0,10" MaxLength="64" />
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="9,0,9,9">
      <Button Style="{StaticResource ButtonStandardStyle}" IsDefault="True" Margin="0,0,9,0" Width="85" Content="{x:Static resource:Strings.DialogButton_Save}" Click="Save_Click" />
      <Button Style="{StaticResource ButtonStandardStyle}" Width="85" IsCancel="True" Content="{x:Static resource:Strings.DialogButton_Cancel}" />
    </StackPanel>
  </Grid>
</Window>