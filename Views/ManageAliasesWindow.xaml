<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DoMping.Views.ManageAliasesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resource="clr-namespace:DoMping.Properties" Title="{x:Static resource:Strings.ManageAliases_WindowTitle}" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Height="475" Width="460" MinHeight="250" MinWidth="360" Background="#0a0f0c" ResizeMode="CanResize" xmlns:views="clr-namespace:DoMping.Views" PreviewKeyDown="Window_PreviewKeyDown" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="{StaticResource icon.alias}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0" />
      <TextBlock Grid.Row="0" Text="{x:Static resource:Strings.ManageAliases_Header}" Style="{StaticResource OptionHeaderTextStyle}" />
    </StackPanel>
    <DataGrid Name="AliasesDataGrid" Grid.Row="1" Style="{StaticResource DataGridStyle}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static resource:Strings.ManageAliases_Alias}" Width="*" Binding="{Binding Path=Value}">
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
                  <Setter Property="Foreground" Value="#ffffff" />
                </DataTrigger>
              </Style.Triggers>
              <Setter Property="TextBlock.Padding" Value="7,2,10,2" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{x:Static resource:Strings.ManageAliases_Host}" Width=".8*" Binding="{Binding Path=Key}">
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
                  <Setter Property="Foreground" Value="#ffffff" />
                </DataTrigger>
              </Style.Triggers>
              <Setter Property="TextBlock.Padding" Value="7,2,10,2" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="Foreground" Value="#33ff99" />
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
      <Button Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_New" Click="New_Click" />
      <Button Margin="15,0" Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_Edit" IsEnabled="{Binding ElementName=AliasesDataGrid, Path=SelectedItems.Count}" Click="Edit_Click" />
      <Button Width="85" Style="{StaticResource ButtonStandardStyle}" Content="_Remove" IsEnabled="{Binding ElementName=AliasesDataGrid, Path=SelectedItems.Count}" Click="Remove_Click" />
    </StackPanel>
  </Grid>
</Window>